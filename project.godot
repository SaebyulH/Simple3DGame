; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simple3DGame"
run/main_scene="uid://by88g1j3kvcfw"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

SaveManagerSingleton="*res://logic/SaveManager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
ItemFactory="res://logic/ItemDataFactory.gd"
CharacterFactory="res://logic/CharacterDataFactory.gd"
InventoryFactory="res://logic/InventoryDataFactory.gd"
AmmoFactory="res://logic/AmmoDataFactory.gd"

[dialogic]

directories/dch_directory={
"arms_dealer": "res://dialogic/characters/arms_dealer.dch",
"mysterious_box": "res://dialogic/characters/mysterious_box.dch",
"wise_crab": "res://dialogic/characters/wise_crab.dch"
}
directories/dtl_directory={
"crab_conversation": "res://dialogic/timelines/crab_conversation.dtl",
"crab_conversation_2": "res://dialogic/timelines/crab_conversation_2.dtl",
"default_merchant_timeline": "res://dialogic/timelines/default_merchant_timeline.dtl",
"default_npc_timeline": "res://dialogic/timelines/default_npc_timeline.dtl",
"shit_timeline": "res://dialogic/timelines/shit_timeline.dtl"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=false
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=true
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autocolor_names=true
text/autopauses={}
variables={}
layout/style_list=["res://Dialogic/styles/New_Style.tres"]
layout/default_style="res://Dialogic/styles/New_Style.tres"
glossary/default_case_sensitive=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/scale=2.0

[dotnet]

project/assembly_name="Simple3DGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/Asset_Drawer/plugin.cfg", "res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "gray",
"res://common/": "gray",
"res://dialogic/": "gray",
"res://effects/": "gray",
"res://entities/": "red",
"res://entities/saveable_character_bodies/": "yellow",
"res://entities/saveable_rigid_bodies/": "green",
"res://entities/saveables/": "orange",
"res://interface/": "blue",
"res://logic/": "teal",
"res://places/": "pink"
}

[global_group]

crit_hurtbox=""

